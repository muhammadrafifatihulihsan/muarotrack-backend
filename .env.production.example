# ============================================================
# MuaroTrack — Environment PRODUCTION (template)
# Salin file ini menjadi .env.production lalu isi nilai sebenarnya:
#   cp .env.production.example .env.production
# PERINGATAN: JANGAN commit file .env.production ke git!
# ============================================================

# Mode eksternal: false = panggil API asli (GEE, Open-Meteo, TideCheck, DeepSeek, Expo)
MOCK_EXTERNAL=false

# Kredensial database PostGIS (dipakai oleh docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=muarotrack

# DATABASE_URL TIDAK perlu diisi manual untuk compose production —
# sudah dibangun otomatis dari POSTGRES_* menuju host 'db'.
# Untuk deploy non-compose (Railway/Render), isi manual:
# DATABASE_URL=postgresql://user:pass@host:5432/muarotrack

# --- API Key Eksternal ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TIDECHECK_API_KEY=your_tidecheck_api_key_here
WORLDTIDES_API_KEY=your_worldtides_api_key_here
GEE_PROJECT_ID=your-gee-project-id
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# --- Parameter Aplikasi ---
WHISPER_MODEL_SIZE=small
SOS_RADIUS_KM=10.0

# Grid zona rekomendasi dinamis
ZONA_RADIUS_MAKS_KM=22.0
ZONA_JUMLAH_TITIK=5
BEARING_LAUT_DEG=270.0

# Scheduler latar belakang. Set false hanya jika menjalankan lebih dari 1 replica API.
RUN_SCHEDULER=true