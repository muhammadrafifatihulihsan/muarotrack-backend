# Flag untuk mengaktifkan mock data (true: menggunakan data tiruan lokal, false: memanggil API asli)
MOCK_EXTERNAL=true

# Koneksi Database (Ganti URL untuk berganti antara lokal Docker dan Supabase cloud)
# Lokal Docker: postgresql://postgres:postgres@localhost:5432/muarotrack
# Supabase: postgresql://postgres.[username]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muarotrack
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/muarotrack

# API Key DeepSeek (Daftar di https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# API Key TideCheck (Daftar di https://tidecheck.com/developers)
TIDECHECK_API_KEY=your_tidecheck_api_key_here

# API Key WorldTides (Cadangan - Opsional)
WORLDTIDES_API_KEY=your_worldtides_api_key_here

# Google Earth Engine (GEE) Project ID (Daftar di https://earthengine.google.com/signup)
GEE_PROJECT_ID=your-gee-project-id

# Expo Push Token (Daftar di https://expo.dev)
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Model size untuk faster-whisper STT ('tiny', 'base', 'small')
WHISPER_MODEL_SIZE=small

# Radius notifikasi SOS (dalam kilometer) untuk menyebarkan notifikasi ke nelayan sekitar
SOS_RADIUS_KM=10.0

# Grid zona rekomendasi dinamis (dibangun dari posisi nelayan)
ZONA_RADIUS_MAKS_KM=22.0
ZONA_JUMLAH_TITIK=5
BEARING_LAUT_DEG=270.0

# Scheduler background jobs (true=aktif; false=matikan bila production multi-replica)
RUN_SCHEDULER=true
